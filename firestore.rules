rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for security auditing & validation
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles — users can only read and write their own document
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
      allow delete: if false; // User accounts cannot be deleted directly via client SDK
    }

    // Scans collection — satellite analysis results
    match /scans/{scanId} {
      // Anyone authenticated can read scan metadata
      allow read: if isAuthenticated();
      
      // Scans can only be created by authenticated users, with user ID tied to auth token
      allow create: if isAuthenticated() 
        && request.resource.data.userId == request.auth.uid;
        
      // Scans are immutable once created (no update/delete from client)
      allow update, delete: if false;
    }

    // Temporal analyses collection
    match /temporal/{analysisId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() 
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Default fallback rule — deny all unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
