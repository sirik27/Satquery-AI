# === DrishtiAI Backend Environment ===

# Firebase Configuration
FIREBASE_PROJECT_ID=satqueryai-9bda3
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# Server
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://*.vercel.app

# Database (SQLite by default, cross-platform)
DATABASE_URL=sqlite:///./data/drishti.db

# YOLO Model
YOLO_MODEL_PATH=yolov8n.pt

# Development Mode (set to true to bypass Firebase auth)
DEV_MODE=true

# Tile Cache Directory
TILE_CACHE_DIR=./data/tile_cache
